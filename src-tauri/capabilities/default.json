{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões estritamente necessárias para a janela principal do PickBoard.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "clipboard-manager:allow-write-text",
    "dialog:allow-confirm",
    "store:default"
  ]
}

