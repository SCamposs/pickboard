{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PickBoard",
  "version": "0.2.3",
  "identifier": "br.dev.italoscampos.pickboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PickBoard",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/champions/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Ítalo Soares Campos",
    "category": "Utility",
    "shortDescription": "Fast, local League of Legends draft tracking",
    "longDescription": "Track picks and bans, organize champion pools, and copy structured draft prompts.",
    "copyright": "Copyright © 2026 Ítalo Soares Campos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDVBMDY3RkUwMUNDQjQxOEQKUldTTlFjc2M0SDhHV3RxdmRtZzJSQkRiekp0T1diN0haeCtBRHByMUdtZDk5cmJadWkxZ0IwOTAK",
      "endpoints": [
        "https://github.com/SCamposs/pickboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
